<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.lunarbit.lunarcore</groupId>
    <artifactId>lunarcore-quilt</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>LunarCore Quilt SDK</name>
    <description>Quilt-native foundational SDK for mod development. Provides lifecycle helpers, logging, configuration, and metadata utilities following the LunarCore specification.</description>
    <url>https://github.com/LunarBit-dev/LunarCore-quilt</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>lunarbit</id>
            <name>LunarBit Studios</name>
            <url>https://github.com/LunarBit-dev</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/LunarBit-dev/LunarCore-quilt.git</connection>
        <developerConnection>scm:git:ssh://github.com/LunarBit-dev/LunarCore-quilt.git</developerConnection>
        <url>https://github.com/LunarBit-dev/LunarCore-quilt</url>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <minecraft.version>1.20.6</minecraft.version>
        <quilt.loader.version>0.26.3</quilt.loader.version>
        <quilt.mappings.version>1.20.6+build.6</quilt.mappings.version>
        <quilted.fabric.api.version>10.0.0-alpha.3+0.100.4-1.20.6</quilted.fabric.api.version>
        <mixin.version>0.8.5</mixin.version>
    </properties>

    <repositories>
        <repository>
            <id>quilt-releases</id>
            <name>Quilt Maven Releases</name>
            <url>https://maven.quiltmc.org/repository/release/</url>
        </repository>
        <repository>
            <id>quilt-snapshots</id>
            <name>Quilt Maven Snapshots</name>
            <url>https://maven.quiltmc.org/repository/snapshot/</url>
        </repository>
        <repository>
            <id>minecraft-libraries</id>
            <name>Minecraft Libraries</name>
            <url>https://libraries.minecraft.net/</url>
        </repository>
        <repository>
            <id>sponge</id>
            <name>Sponge Maven Repository</name>
            <url>https://repo.spongepowered.org/maven</url>
        </repository>
        <repository>
            <id>fabricmc</id>
            <name>Fabric Maven</name>
            <url>https://maven.fabricmc.net/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Minecraft Client (provided at runtime by Quilt) -->
        <dependency>
            <groupId>com.mojang</groupId>
            <artifactId>minecraft</artifactId>
            <version>${minecraft.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Quilt Loader -->
        <dependency>
            <groupId>org.quiltmc</groupId>
            <artifactId>quilt-loader</artifactId>
            <version>${quilt.loader.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Quilt Standard Libraries (QSL) Base -->
        <dependency>
            <groupId>org.quiltmc.qsl.core</groupId>
            <artifactId>qsl_base</artifactId>
            <version>9.0.0-alpha.1+1.20.6</version>
            <scope>provided</scope>
        </dependency>

        <!-- Quilted Fabric API -->
        <dependency>
            <groupId>org.quiltmc.quilted-fabric-api</groupId>
            <artifactId>quilted-fabric-api</artifactId>
            <version>${quilted.fabric.api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Mixin -->
        <dependency>
            <groupId>org.spongepowered</groupId>
            <artifactId>mixin</artifactId>
            <version>${mixin.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- SLF4J API (Quilt's logging) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.9</version>
            <scope>provided</scope>
        </dependency>

        <!-- JUnit for testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/java</sourceDirectory>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>
            <!-- Maven Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.12.1</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- Maven Resources Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- Maven JAR Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Implementation-Title>${project.name}</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                            <Implementation-Vendor>LunarBit Studios</Implementation-Vendor>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- Maven Source Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Maven Javadoc Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <source>21</source>
                    <encoding>UTF-8</encoding>
                    <quiet>true</quiet>
                    <doclint>none</doclint>
                </configuration>
            </plugin>

            <!-- Maven Surefire Plugin (for tests) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.3</version>
            </plugin>

            <!-- Maven Deploy Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.1.1</version>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/Lunarbit-dev/lunarcore-maven</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/Lunarbit-dev/lunarcore-maven</url>
        </snapshotRepository>
    </distributionManagement>
</project>

